{
  "name": "dubbattle-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio local de fabrication des extraits de Dub-Battle",
  "scripts": {
    "studio": "vite build && tsx server/index.ts",
    "dev": "concurrently -k -n serveur,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig web/tsconfig.json",
    "test": "vitest run",
    "python:installer": "node scripts/installer-python.mjs",
    "ytdlp:maj": "node scripts/installer-python.mjs --ytdlp"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
