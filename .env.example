# Configuration du Studio : copier ce fichier en .env (jamais commité).
# Toutes les valeurs sont facultatives : vide = valeur par défaut.

# Port du serveur local (défaut : 5180, soit http://localhost:5180)
PORT=

# Clone local du dépôt dubbattle-extraits, où le Studio publie (défaut : ../extraits)
DOSSIER_EXTRAITS=
# Fichiers de travail : WAV, aperçus, encodages (défaut : ../studio-workspace)
DOSSIER_ESPACE=
# Modèles d'IA téléchargés au premier usage (défaut : ./models)
DOSSIER_MODELES=

# Adresse publique des extraits, pour vérifier le déploiement après publication
URL_EXTRAITS=https://dubbattle-extraits.pages.dev

# Modèle Whisper pour la transcription (défaut : large-v3-turbo ; aussi large-v3, medium…)
MODELE_WHISPER=

# Téléchargement depuis YouTube : navigateur dont yt-dlp reprend les cookies, pour les vidéos
# réservées aux comptes connectés (limite d'âge…). Vide = aucun ; sinon chrome, firefox, edge, safari…
COOKIES_NAVIGATEUR=

# Chemins des outils, s'ils ne sont pas dans le PATH (défaut : ffmpeg, ffprobe, git,
# et le Python de studio/.venv)
FFMPEG=
FFPROBE=
PYTHON=
GIT=
